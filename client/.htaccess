    RewriteRule ^th/packing-loading\.php$ /th/service/packing-loading [R=301,L]
    RewriteRule ^en/packing-loading\.php$ /en/service/packing-loading [R=301,L]
    RewriteRule ^jp/packing-loading\.php$ /jp/service/packing-loading [R=301,L]

    RewriteRule ^th/cookie-policy\.php$ /th/cookie-policy [R=301,L]
    RewriteRule ^en/cookie-policy\.php$ /en/cookie-policy [R=301,L]
    RewriteRule ^jp/cookie-policy\.php$ /jp/cookie-policy [R=301,L]

    RewriteRule ^th/privacy-notice\.php$ /th/privacy-notice [R=301,L]
    RewriteRule ^en/privacy-notice\.php$ /en/privacy-notice [R=301,L]
    RewriteRule ^jp/privacy-notice\.php$ /jp/privacy-notice [R=301,L]

    RewriteRule ^admin/login/index$ /webpanel [R=301,L]

</IfModule>
